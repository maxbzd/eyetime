{
  "manifest_version": 3,
  "name": "EyeTime Bridge",
  "version": "0.1.0",
  "description": "Lets the EyeTime app close pages: whole sites, single pages, and words, while a block runs. Talks only to EyeTime on this computer.",
  "key": "",
  "minimum_chrome_version": "110",
  "icons": { "128": "icon128.png" },
  "permissions": ["tabs", "webNavigation", "nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" }
}
