{
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true,
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "skipLibCheck": true, "types": [],
    // strict, one flag at a time: the ones below are on now; noImplicitAny (3 400 places) and strictNullChecks (about 490) are the two that remain
    "alwaysStrict": true, "noImplicitThis": true, "strictBindCallApply": true, "strictFunctionTypes": true, "useUnknownInCatchVariables": true,
    "noImplicitAny": false, "strictNullChecks": false
  },
  "include": ["src/shared/**/*.js", "src/background/*.js", "src/ui/**/*.js", "src/newtab/*.js", "src/newtab/home/*.js", "src/newtab/scene/*.js", "src/newtab/today/*.js", "src/options/*.js", "src/insights/*.js", "src/popup/*.js", "src/blocked/*.js", "src/break/*.js", "src/onboarding/*.js", "src/dock/*.js", "src/types.d.ts"]
}
