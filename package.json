{
  "name": "eyetime",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Focus, screen time and eye care for your browser. Free, open source, local-first.",
  "scripts": {
    "check": "node scripts-dev/check.mjs && node --test scripts-dev/tests/*.test.mjs",
    "test": "node --test scripts-dev/tests/*.test.mjs",
    "icons": "node scripts-dev/build-icons.mjs",
    "lint": "npx --yes eslint src scripts-dev/*.mjs",
    "types": "npx --yes -p typescript tsc -p tsconfig.json",
    "build": "node scripts-dev/check.mjs && node scripts-dev/pack.mjs"
  }
}
